# Eyelore — copy to .env.local (root, apps/web, apps/mobile as noted). Never commit real values.
# Missing keys run as labelled stubs; see PLAN.md "Needs keys".

# ── Convex ── (root .env.local is written by `npx convex dev`)
CONVEX_DEPLOYMENT=
# apps/web/.env.local
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# apps/mobile/.env.local
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# CI only (GitHub secrets): CONVEX_DEPLOY_KEY (prod), CONVEX_PREVIEW_DEPLOY_KEY (previews)

# Convex env: the public web origin, used for Stripe return URLs and links in emails (no trailing slash)
EYELORE_WEB_URL=

# ── Clerk ── (Convex env: CLERK_JWT_ISSUER_DOMAIN, CLERK_WEBHOOK_SECRET)
# JWT template in Clerk must be named "convex". Webhook endpoint: <convex site url>/clerk/webhook (user.created, user.updated, user.deleted).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=

# ── Stripe ── (Convex env for secrets; web for the publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Convex env: Stripe price ids (never hardcoded). Webhook endpoint: <convex site url>/stripe/webhook
# (checkout.session.completed, customer.subscription.updated, customer.subscription.deleted).
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_LARGE=

# ── SendPulse ── (Convex env)
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
# a sender address verified in SendPulse
SENDPULSE_FROM_EMAIL=

# ── Sentry ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# source-map upload happens only when SENTRY_AUTH_TOKEN is set (with org and project); builds work without it
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Vercel / EAS ── (GitHub secrets for CI)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
EXPO_TOKEN=

# ── Waking a scale-to-zero worker ── (Convex env; the URL is printed by `modal deploy`. Unset = nothing to wake)
EYELORE_WAKE_URL=

# ── Engine worker ── (Colab / Modal / RunPod secret store)
EYELORE_CONVEX_SITE_URL=http://127.0.0.1:3211
EYELORE_WORKER_TOKEN=
EYELORE_PROVIDER=cpu
EYELORE_WORKER_NAME=
HF_TOKEN=

# ── Funnel dashboard ── (Convex env: set with `npx convex env set`, never in git. Unset = /funnel says "not configured")
EYELORE_ADMIN_TOKEN=
