{
  "expo": {
    "name": "eyelore",
    "slug": "eyelore",
    "scheme": "eyelore",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b7feb40-3b59-4dbd-8206-9f02701ac8ec"
    },
    "ios": {
      "bundleIdentifier": "app.eyelore",
      "supportsTablet": false
    },
    "android": {
      "package": "app.eyelore"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Eyelore uses the camera to record your takes.",
          "microphonePermission": "Eyelore uses the microphone to record what you say.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eyelore opens the clips you choose from your library."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Eyelore saves your finished edits to your camera roll.",
          "photosPermission": "Eyelore saves your finished edits to your camera roll.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4b7feb40-3b59-4dbd-8206-9f02701ac8ec"
      }
    },
    "owner": "devluca999"
  }
}
